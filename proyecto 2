#include <WiFi.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <time.h>

// Datos de tu Wi-Fi
const char* ssid = "S23 de Franco";
const char* password = "Franco45127";

// Pantalla LCD I2C
LiquidCrystal_I2C lcd(0x27, 16, 2);

// Pines ESP32
const int SDA_PIN = 21;
const int SCL_PIN = 22;
const int POT_PIN = 34;

// Hora de Colombia: UTC-5
const long GMT_OFFSET = -5 * 3600;
const int DAYLIGHT_OFFSET = 0;

// ADC de 12 bits
const int ADC_MAX = 4095;
const float VOLTAJE_REFERENCIA = 3.3;

unsigned long ultimoCambio = 0;
bool mostrarVoltaje = false;

void setup() {
  Serial.begin(115200);

  Wire.begin(SDA_PIN, SCL_PIN);
  lcd.init();
  lcd.backlight();

  analogReadResolution(12);
  analogSetPinAttenuation(POT_PIN, ADC_11db);

  lcd.setCursor(0, 0);
  lcd.print("Conectando WiFi");

  WiFi.begin(ssid, password);

  int intentos = 0;
  while (WiFi.status() != WL_CONNECTED && intentos < 30) {
    delay(500);
    intentos++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    configTime(GMT_OFFSET, DAYLIGHT_OFFSET,
               "pool.ntp.org", "time.nist.gov");
    lcd.clear();
    lcd.print("WiFi conectado");
    Serial.println("WiFi conectado");
  } else {
    lcd.clear();
    lcd.print("Error de WiFi");
    Serial.println("No se pudo conectar al WiFi");
  }

  delay(1500);
  lcd.clear();
}

void loop() {
  // Leer potenciometro
  int valorADC = analogRead(POT_PIN);

  // Calcular voltaje estimado y porcentaje
  float voltaje = (valorADC / (float)ADC_MAX) *
                  VOLTAJE_REFERENCIA;
  int porcentaje = map(valorADC, 0, ADC_MAX, 0, 100);

  // Obtener hora actual
  struct tm hora;
  bool horaValida = getLocalTime(&hora, 100);

  lcd.setCursor(0, 0);

  if (horaValida) {
    char textoHora[9];
    strftime(textoHora, sizeof(textoHora), "%H:%M:%S", &hora);
    lcd.print("Hora: ");
    lcd.print(textoHora);
    lcd.print("  ");
  } else {
    lcd.print("Hora: --:--:--  ");
  }

  // Alternar la segunda fila para mostrar ambos datos
  if (millis() - ultimoCambio >= 1500) {
    ultimoCambio = millis();
    mostrarVoltaje = !mostrarVoltaje;
  }

  lcd.setCursor(0, 1);
  if (mostrarVoltaje) {
    lcd.print("Voltaje:");
    lcd.print(voltaje, 2);
    lcd.print(" V   ");
  } else {
    lcd.print("ADC:");
    lcd.print(valorADC);
    lcd.print(" ");
    lcd.print(porcentaje);
    lcd.print("%    ");
  }

  // Mostrar todos los datos en el Monitor serie
  Serial.print("Hora: ");
  if (horaValida) {
    char textoHora[9];
    strftime(textoHora, sizeof(textoHora), "%H:%M:%S", &hora);
    Serial.print(textoHora);
  } else {
    Serial.print("No sincronizada");
  }

  Serial.print(" | ADC: ");
  Serial.print(valorADC);

  Serial.print(" | Porcentaje: ");
  Serial.print(porcentaje);
  Serial.print("%");

  Serial.print(" | Voltaje estimado: ");
  Serial.print(voltaje, 3);
  Serial.println(" V");

  delay(500);
}

