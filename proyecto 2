# ejercicion  1  Diseña un programa para el ESP32 que permita crear un juego interactivo de “Adivinar el número” usando comunicación UART. El sistema debe iniciar solicitando al usuario, por medio del puerto serial, los valores mínimo y máximo del rango donde se generará un número aleatorio. Luego, el jugador deberá enviar intentos por UART para descubrir cuál es el número secreto y si no lo adivina indicar si es menor o mayor.
String entrada;

int minimo, maximo, numeroSecreto, intento;
bool esperandoMinimo = true;
bool esperandoMaximo = false;
bool esperandoIntento = false;

bool esNumero(String texto) {
  if (texto.length() == 0) return false;

  int inicio = 0;
  if (texto[0] == '-' || texto[0] == '+') inicio = 1;
  if (inicio == texto.length()) return false;

  for (int i = inicio; i < texto.length(); i++) {
    if (!isDigit(texto[i])) return false;
  }
  return true;
}

void setup() {
  Serial.begin(115200);
  randomSeed(micros());

  Serial.println();
  Serial.println("==================================");
  Serial.println(" JUEGO: ADIVINAR EL NUMERO");
  Serial.println(" Comunicacion UART - ESP32");
  Serial.println("==================================");
  Serial.println("Ingresa el valor MINIMO:");
}

void loop() {
  if (Serial.available() <= 0) return;

  entrada = Serial.readStringUntil('\n');
  entrada.trim();

  if (entrada.length() == 0) return;

  if (!esNumero(entrada)) {
    Serial.println("ERROR: ingresa un numero entero.");
    return;
  }

  long valor = entrada.toInt();

  if (valor < -2147483647L || valor > 2147483647L) {
    Serial.println("ERROR: numero fuera de rango.");
    return;
  }

  if (esperandoMinimo) {
    minimo = (int)valor;

    esperandoMinimo = false;
    esperandoMaximo = true;

    Serial.print("Minimo ingresado: ");
    Serial.println(minimo);
    Serial.println("Ingresa el valor MAXIMO:");
  }
  else if (esperandoMaximo) {
    maximo = (int)valor;

    if (maximo <= minimo) {
      Serial.println("ERROR: el maximo debe ser mayor que el minimo.");
      Serial.println("Ingresa nuevamente el MAXIMO:");
      return;
    }

    if ((long long)maximo - minimo > 2147483646LL) {
      Serial.println("ERROR: el rango es demasiado grande.");
      Serial.println("Ingresa otro valor MAXIMO:");
      return;
    }

    Serial.println();
    Serial.println("===== RANGO CONFIGURADO =====");

    Serial.print("Minimo: ");
    Serial.println(minimo);

    Serial.print("Maximo: ");
    Serial.println(maximo);

    Serial.print("Rango permitido: [");
    Serial.print(minimo);
    Serial.print(" - ");
    Serial.print(maximo);
    Serial.println("]");

    Serial.print("Cantidad de numeros posibles: ");
    Serial.println((long long)maximo - minimo + 1);

    numeroSecreto = (int)random(
      (long)minimo, (long)maximo + 1L
    );

    esperandoMaximo = false;
    esperandoIntento = true;

    Serial.println("==============================");
    Serial.println("Numero secreto generado.");
    Serial.println("Adivina el numero:");
  }
  else if (esperandoIntento) {
    intento = (int)valor;

    Serial.println();
    Serial.println("===== NUEVO INTENTO =====");

    Serial.print("Rango permitido: [");
    Serial.print(minimo);
    Serial.print(" - ");
    Serial.print(maximo);
    Serial.println("]");

    Serial.print("Tu intento: ");
    Serial.println(intento);

    if (intento < minimo || intento > maximo) {
      Serial.println("Fuera del rango permitido.");
    }
    else if (intento < numeroSecreto) {
      Serial.println("PISTA: el numero secreto es MAYOR.");
    }
    else if (intento > numeroSecreto) {
      Serial.println("PISTA: el numero secreto es MENOR.");
    }
    else {
      Serial.println("FELICIDADES! ADIVINASTE.");
      Serial.print("Numero secreto: ");
      Serial.println(numeroSecreto);

      esperandoIntento = false;
      esperandoMinimo = true;

      Serial.println();
      Serial.println("Nueva partida.");
      Serial.println("Ingresa el valor MINIMO:");
    }

    Serial.println("=========================");
  }
}

